    "category": "Wireless Attacks",
    "desc": "Audit 802.11 wireless network security.",
    "steps": [
      ["Enable monitor mode", "sudo airmon-ng start wlan0"],
      ["Scan wireless networks", "sudo airodump-ng wlan0mon"],

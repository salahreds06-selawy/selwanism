{
  "hydra": {
    "title": "Hydra - Fast Network Logon Cracker",
    "category": "Password Cracking",
    "desc": "Brute-force authentication protocols over the network.",
    "steps": [
      ["SSH login brute-force", "hydra -l root -P rockyou.txt ssh://<IP>"],
      ["FTP login brute-force", "hydra -l admin -P rockyou.txt ftp://<IP>"],
      ["HTTP POST form brute-force", "hydra -l admin -P rockyou.txt <IP> http-post-form \"/login.php:user=^USER^&pass=^PASS^:F=incorrect\""],
      ["RDP login brute-force", "hydra -l administrator -P rockyou.txt rdp://<IP>"]
    ]
  },
  "john": {
    "title": "John the Ripper - Password Cracker",
    "category": "Password Cracking",
    "desc": "Offline password hash cracking suite.",
    "steps": [
      ["Basic wordlist crack", "john --wordlist=rockyou.txt hashes.txt"],
      ["Show cracked passwords", "john --show hashes.txt"],
      ["Combine passwd and shadow files", "unshadow /etc/passwd /etc/shadow > combined.txt"],
      ["Crack combined shadow file", "john --wordlist=rockyou.txt combined.txt"]
    ]
  },
  "hash_cracking": {
    "title": "Hashcat - GPU Hash Cracker",
    "category": "Password Cracking",
    "desc": "GPU-accelerated password recovery utility.",
    "steps": [
      ["Identify hash type", "hash-identifier"],
      ["Crack MD5 hashes", "hashcat -m 0 hashes.txt rockyou.txt"],
      ["Crack SHA256 hashes", "hashcat -m 1400 hashes.txt rockyou.txt"],
      ["Crack NTLM hashes", "hashcat -m 1000 hashes.txt rockyou.txt"],
      ["Display cracked results", "hashcat -m 0 hashes.txt --show"]
    ]
  }
}
